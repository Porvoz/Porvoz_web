# ============================================================================
# PORVOZ — Environment Configuration Template
# Copy this file to .env and fill with YOUR credentials
# NEVER commit .env to GitHub (it's in .gitignore)
# ============================================================================

# ============================================================================
# DEVELOPMENT ONLY (sqlite, in-memory cache, console email)
# ============================================================================
DJANGO_ENVIRONMENT=development

# Django Secret Key
# For development: any string is fine (used below for dev security)
# For production: generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=dev-secret-key-change-me-for-production

# ============================================================================
# EMAIL CONFIGURATION (Gmail SMTP)
# ============================================================================
# Instructions to get App Password:
# 1. Go to myaccount.google.com
# 2. Enable 2FA (Security → 2-Step Verification)
# 3. Go to Security → App passwords
# 4. Select Mail + Windows Computer
# 5. Copy the 16-char password
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
DEFAULT_FROM_EMAIL=noreply@porvoz.com

# Fallback for development: if EMAIL_HOST_PASSWORD is empty, emails print to console

# ============================================================================
# TWILIO CONFIGURATION (Voice Calls)
# ============================================================================
# Get from https://www.twilio.com/console/account/settings
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
TWILIO_BASE_URL=http://localhost:8000

# For development/testing: set to true to simulate calls without charges
TWILIO_DRY_RUN=true
TWILIO_VALIDATE_SIGNATURE=true

# ============================================================================
# GOOGLE GEMINI API (Call Classification & Transcription)
# ============================================================================
# Get key from https://ai.google.dev/ (free tier available)
GEMINI_API_KEY=AIzaSyD_your_key_here

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Development: SQLite automatically (no need to set)
# Docker/Production: PostgreSQL via DATABASE_URL (set by docker-compose)
# DB_PASSWORD is used by docker-compose.yml to build DATABASE_URL
DB_PASSWORD=porvoz_secure_password_change_me

# If connecting remotely (e.g., AWS RDS):
# DATABASE_URL=postgresql://user:password@rds-endpoint.amazonaws.com:5432/porvoz

# ============================================================================
# REDIS CONFIGURATION (Cache & Celery Broker)
# ============================================================================
# Development: in-memory cache (no need to set)
# Docker: Redis container (set by docker-compose)
# AWS: ElastiCache
# REDIS_URL=redis://localhost:6379/0

# ============================================================================
# DEPLOYMENT / PRODUCTION CONFIGURATION
# ============================================================================
# Only set these if deploying (Docker, AWS, Railway, etc.)

# Allowed hostnames (comma-separated, no wildcards in production!)
# Example: api.porvoz.com,porvoz.com,www.porvoz.com
# ALLOWED_HOSTS=api.porvoz.com,porvoz.com

# Base URL for Twilio webhooks (must be public HTTPS in production)
# Example: https://api.porvoz.com
# BASE_URL=https://api.porvoz.com

# ============================================================================
# CELERY CONFIGURATION (Async Tasks)
# ============================================================================
# Set by docker-compose, but can override if needed:
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0
