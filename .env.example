# ── Django ──────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_SETTINGS_MODULE=config.settings.production

# Dominio público (sin trailing slash). En dev usa la URL de ngrok.
ALLOWED_HOSTS=tudominio.com,www.tudominio.com

# ── Base de datos ────────────────────────────────────────────────────────────
# Docker Compose la construye automáticamente — solo cambia DB_PASSWORD.
DB_PASSWORD=porvoz_secret
# Si apuntas a una base de datos externa, define DATABASE_URL directamente:
# DATABASE_URL=postgresql://user:pass@host:5432/porvoz

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# ── Email (Gmail SMTP) ───────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST_USER=porvozcolombia@gmail.com
EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx
DEFAULT_FROM_EMAIL=Porvoz <porvozcolombia@gmail.com>

# ── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# URL pública donde Twilio enviará webhooks (tu dominio o URL de ngrok en dev)
TWILIO_BASE_URL=https://tudominio.com

# ── Google Gemini ────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
