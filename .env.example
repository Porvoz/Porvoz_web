# Copia este archivo como .env y completa los valores
# El .env real nunca se sube a git

# Django
DJANGO_SECRET_KEY=cambia-esto-en-produccion

# Twilio (obtener en twilio.com/console)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Google Gemini (obtener en aistudio.google.com)
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL pública donde Twilio envía los webhooks
# En desarrollo: usar ngrok → ngrok http 8000
TWILIO_BASE_URL=https://xxxx-xxxx-xxxx.ngrok.io
