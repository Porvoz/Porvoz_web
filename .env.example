# Django Configuration
DJANGO_SECRET_KEY=dev-secret-key-change-me
DJANGO_ENVIRONMENT=development

# Email Configuration (Gmail SMTP)
# Get credentials from your Gmail account:
# 1. Enable 2FA in Gmail
# 2. Generate an App Password at myaccount.google.com/apppasswords
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=noreply@porvoz.com

# Twilio Configuration (Voice Calls)
# Get credentials from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+1234567890
TWILIO_BASE_URL=http://localhost:8000
TWILIO_VALIDATE_SIGNATURE=true
TWILIO_DRY_RUN=false

# Google Gemini API (for call classification)
# Get key from https://ai.google.dev/
GEMINI_API_KEY=your-gemini-api-key

# Database (production/Docker only — development uses SQLite automatically)
# DB_PASSWORD is read by docker-compose.yml to build DATABASE_URL
DB_PASSWORD=porvoz_secret
# DATABASE_URL=postgresql://porvoz:porvoz_secret@db:5432/porvoz

# Redis (production/Docker only — development uses in-memory broker)
# REDIS_URL=redis://localhost:6379/0

# Base URL (used for webhooks)
BASE_URL=http://localhost:8000
